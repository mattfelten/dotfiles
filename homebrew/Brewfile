# Everything I might want on a machine. `npm run homebrew` shows this as a
# checklist (all selected) so each machine gets only what it needs.
#
#   ## Heading      starts a group in the checklist
#   # comment       ignored
#   ... # hint      trailing comments show up as hints
#
# Casks and mas apps are hidden automatically off macOS.

## Shell
brew 'antidote'
brew 'powerlevel10k'

## Dev
brew 'gh'
brew 'glab'
cask "claude-code"
cask "visual-studio-code"

## Communication
cask "slack"
cask "zoom" # Ugh
cask "discord"
cask "mimestream"
cask "granola"
cask "loom"

## Design & capture
cask "figma"
cask "cleanshot"
cask "screen-studio"
mas "Hand Mirror", id: 1502839586

## Apps
cask "claude"

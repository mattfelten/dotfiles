#!/usr/bin/env bash
# git delete [branch]
# Delete a branch locally and on origin. Defaults to the current branch,
# after switching to the default branch.
source "$HOME/.local/lib/git-branch.sh"

main="$(default_branch)"
b="${1:-$(current)}"
[ "$b" != "$main" ] || die "Not deleting $main"

if [ "$b" = "$(git symbolic-ref --quiet --short HEAD)" ]; then
  # Bring local main up to the merge first, so uncommitted edits to files the
  # branch changed don't block the switch.
  git fetch --quiet origin
  update_local_default "$main"
  git switch "$main"
fi
if on_origin "$b"; then
  git push origin --delete "$b"
fi
git branch -D "$b"

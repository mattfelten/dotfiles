{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "ask": [
      "Bash(git worktree remove:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --rawfile c $HOME/Projects/personal/ai-brain/INDEX.md '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:(\"Persistent knowledge base (\\\"ai-brain\\\") at ~/Projects/personal/ai-brain - long-term git-synced memory shared across all projects. How notes are organized lives in its CLAUDE.md (Claude owns the structure). Below is the ROOT MAP of that memory, which is a tree: read only the branch your task needs. Each folder has its own INDEX.md mapping its direct children; descend from here as the task requires, do not load sibling branches. Record durable facts per its CLAUDE.md.\\n\\n\" + $c)}}' 2>/dev/null || true",
            "statusMessage": "Loading ai-brain index"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/dispatch.sh\" ] || exit 0; sh \"$HOME/.claude/hooks/dispatch.sh\"",
            "statusMessage": "Running pre-tool checks"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "mission-mcp@mission-mcp": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "mission-mcp": {
      "source": {
        "source": "git",
        "url": "https://gitlab.com/missioncloud/platform/mission-mcp-server.git"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "teammateMode": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
